<Application x:Class="RealmOfThronesLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The Keep look of the window frame (keys start with Keep.): the colours first, then the styles that use them. -->
                <ResourceDictionary Source="Keep/KeepColors.xaml"/>
                <ResourceDictionary Source="Keep/KeepTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Every hover tip in this tool is a dark card in the Keep colours, wrapped at 320. -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
                <Setter Property="Background" Value="{DynamicResource Keep.BgPanel}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Keep.BorderDim}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="FlowDirection" Value="{Binding PlacementTarget.FlowDirection, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7" MaxWidth="320">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
