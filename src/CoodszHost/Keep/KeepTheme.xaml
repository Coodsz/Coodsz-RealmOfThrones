<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Coodsz.Ui"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        The shared look of the pages and windows added with the CoopKeep port (Home, Players, Cheats,
        player profile, Items, New world, Encyclopedia, Guides, Map). Every value here is one of
        Coodsz Coop Server Tool's own window colours and styles from MainWindow.xaml (Card, Ghost, Primary, Danger,
        SectionTitle, the text box, check box and DifficultyBox), so these pages look like the Server,
        Settings, Modules and Logs pages. Every key starts with Keep. so nothing here changes the rest
        of the window.
    -->
    <!-- The colours (Keep.BgDeep, Keep.TextMain, Keep.Accent and the rest) are in KeepColors.xaml. -->
    <!-- Text: headings are the SectionTitle style of the Server page ("Server overview", "Game time"). -->
    <Style x:Key="Keep.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
    </Style>
    <Style x:Key="Keep.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
    </Style>
    <Style x:Key="Keep.Dim" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextDim}"/>
    </Style>
    <Style x:Key="Keep.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextDim}"/>
    </Style>
    <Style x:Key="Keep.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
    </Style>

    <!-- Panels -->
    <Style x:Key="Keep.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Frame}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="Keep.Stat" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Frame}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="92"/>
    </Style>
    <Style x:Key="Keep.Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Frame}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Width" Value="150"/>
    </Style>
    <!-- A backing strip for a line of text that would otherwise sit straight on the backdrop picture (a page intro):
         the near solid card colour, so the text keeps 4.5:1 whatever part of the picture is behind it. -->
    <Style x:Key="Keep.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Frame}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- The notice bar under the setup bar: card colour with a light blue edge on the left. -->
    <Style x:Key="Keep.Note" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style x:Key="Keep.CountBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.Badge}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <!-- Buttons: Ghost, Primary and Danger of the Server page, with the gold edge on hover. -->
    <Style x:Key="Keep.Button" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.BorderDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Gold" TargetType="Button" BasedOn="{StaticResource Keep.Button}">
        <Setter Property="Background" Value="{StaticResource Keep.GoldButton}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.GoldButtonHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Danger" TargetType="Button" BasedOn="{StaticResource Keep.Button}">
        <Setter Property="Background" Value="{StaticResource Keep.RedSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.OnDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.DangerLine}"/>
    </Style>
    <Style x:Key="Keep.Icon" TargetType="Button" BasedOn="{StaticResource Keep.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="Keep.Small" TargetType="Button" BasedOn="{StaticResource Keep.Button}">
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="Keep.SmallGold" TargetType="Button" BasedOn="{StaticResource Keep.Gold}">
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- A whole card that can be clicked (skill cards, troop and item cards, hero rows). -->
    <Style x:Key="Keep.CardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.BorderDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggles: choice cards (Skills, Give items, world presets), underline tabs and filter chips.
         Checked is the selected nav button: dark blue with a light blue edge. -->
    <Style x:Key="Keep.Choice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Keep.BgRaised}" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1"
                            CornerRadius="2" Padding="14,10" MinWidth="96">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextDim}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,8,12,7">
                        <ContentPresenter x:Name="Content" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Keep.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Pill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Keep.BgRaised}" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1"
                            Padding="10,4">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The category sidebar of the Items window: the nav buttons of the main window. -->
    <Style x:Key="Keep.Side" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Keep.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs: the text box, check box and DifficultyBox of the main window. -->
    <Style x:Key="Keep.Text" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Keep.BgInput}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.BorderInput}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Keep.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Foreground="{StaticResource Keep.TextFaint}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Edge" BorderBrush="Transparent" BorderThickness="2" Padding="4,2" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="16" Height="16" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1" Background="{StaticResource Keep.BgInput}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M 2 8 L 6 12 L 14 3" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.6" Visibility="Collapsed" Margin="0,1,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Edge" Background="{StaticResource Keep.BgInput}" BorderBrush="{StaticResource Keep.BorderInput}" BorderThickness="1">
                                        <Path HorizontalAlignment="Right" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{StaticResource Keep.BgInput}" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="False"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{StaticResource Keep.BgInput}" Padding="8,6">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgRaised}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin scroll bar; each page and window turns it on for itself. -->
    <!-- The picture behind the pages (Keep.BackdropArt, set per tool by Backdrop.Apply): its blur radius (0 is sharp) and the
         dark gradient over it, 25% at the top to 70% at the bottom so the picture shows. The near solid cards carry the text contrast. -->
    <Color x:Key="Keep.BackdropOverlayTop">#400E1418</Color>
    <Color x:Key="Keep.BackdropOverlayBottom">#B30E1418</Color>
    <sys:Double x:Key="Keep.BackdropBlur">0</sys:Double>
    <Style x:Key="Keep.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource Keep.BorderDim}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource Keep.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Keep.ScrollThumb}" Margin="1,0"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Keep.ScrollThumb}" Margin="0,1"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icons (stroke paths, 16 x 16). -->
    <Geometry x:Key="Keep.IconClose">M 3 3 L 13 13 M 13 3 L 3 13</Geometry>
    <Geometry x:Key="Keep.IconRefresh">M 13 4 A 6 6 0 1 0 14 9 M 13 1 L 13 4 L 10 4</Geometry>
    <Geometry x:Key="Keep.IconBan">M 8 1 A 7 7 0 1 0 8.01 1 M 3 3 L 13 13</Geometry>
    <Geometry x:Key="Keep.IconGold">M 8 1.5 A 6.5 6.5 0 1 0 8.01 1.5 M 8 4.5 L 8 11.5 M 10.5 6 C 10 4.5 5.5 4.5 5.5 6.5 C 5.5 8.5 10.5 7.5 10.5 9.5 C 10.5 11.5 6 11.5 5.5 10</Geometry>
    <Geometry x:Key="Keep.IconHeart">M 8 14 C 2 9.5 1 7 1 5 C 1 3 2.5 1.5 4.5 1.5 C 6 1.5 7.3 2.5 8 3.8 C 8.7 2.5 10 1.5 11.5 1.5 C 13.5 1.5 15 3 15 5 C 15 7 14 9.5 8 14 Z</Geometry>
    <Geometry x:Key="Keep.IconSwords">M 2 2 L 11 11 M 9 13 L 13 9 M 14 2 L 5 11 M 3 9 L 7 13 M 2 14 L 4 12 M 14 14 L 12 12</Geometry>
    <Geometry x:Key="Keep.IconShield">M 8 1 L 14 3.5 C 14 9 11.5 12.5 8 15 C 4.5 12.5 2 9 2 3.5 Z</Geometry>
    <Geometry x:Key="Keep.IconStar">M 8 1 L 9.6 6.4 L 15 8 L 9.6 9.6 L 8 15 L 6.4 9.6 L 1 8 L 6.4 6.4 Z</Geometry>
    <Geometry x:Key="Keep.IconChest">M 1.5 5 L 14.5 5 L 14.5 14 L 1.5 14 Z M 1.5 5 L 3 2 L 13 2 L 14.5 5 M 1.5 8.5 L 14.5 8.5 M 7 7.5 L 9 7.5 L 9 10 L 7 10 Z</Geometry>
    <Geometry x:Key="Keep.IconInfo">M 8 1 A 7 7 0 1 0 8.01 1 M 8 7 L 8 12 M 8 4.2 L 8 4.8</Geometry>
    <Geometry x:Key="Keep.IconChevron">M 5 3 L 10 8 L 5 13</Geometry>
    <Geometry x:Key="Keep.IconPicture">M 1.5 2.5 L 14.5 2.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 11 L 5.5 7 L 9 10.5 L 11 8.5 L 14.5 12 M 11 5.5 A 1 1 0 1 0 11.01 5.5</Geometry>

    <!-- Page icons of the sidebar (stroke paths on a 24 x 24 grid, from the mockup nav; Keep.Nav draws them 16 px). -->
    <Geometry x:Key="Keep.IconPlay">M 7 4 L 20 12 L 7 20 Z</Geometry>
    <Geometry x:Key="Keep.IconDashboard">M 4 4 h 7 v 7 H 4 Z M 13 4 h 7 v 7 h -7 Z M 4 13 h 7 v 7 H 4 Z M 13 13 h 7 v 7 h -7 Z</Geometry>
    <Geometry x:Key="Keep.IconSaves">M 5 4 h 11 l 3 3 v 13 H 5 Z M 8 4 v 5 h 7 V 4 M 8 20 v -6 h 8 v 6</Geometry>
    <Geometry x:Key="Keep.IconMods">M 12 3 l 8 4 l -8 4 l -8 -4 Z M 4 12 l 8 4 l 8 -4 M 4 16 l 8 4 l 8 -4</Geometry>
    <Geometry x:Key="Keep.IconSettings">M 4 7 h 10 M 18 7 h 2 M 4 17 h 2 M 10 17 h 10 M 14 5 v 4 M 6 15 v 4</Geometry>
    <Geometry x:Key="Keep.IconPlayers">M 9 11 a 3 3 0 1 0 0 -6 a 3 3 0 0 0 0 6 Z M 3 20 c 0 -3 3 -5 6 -5 s 6 2 6 5 M 17 6 a 3 3 0 0 1 0 6 M 21 20 c 0 -2 -1.5 -3.5 -3.5 -4.2</Geometry>
    <Geometry x:Key="Keep.IconCheats">M 12 3 l 2.7 5.6 l 6.1 0.8 l -4.5 4.2 l 1.1 6 L 12 16.7 L 6.6 19.6 l 1.1 -6 L 3.2 9.4 l 6.1 -0.8 Z</Geometry>
    <Geometry x:Key="Keep.IconConsole">M 4 5 h 16 v 14 H 4 Z M 7 10 l 3 2 l -3 2 M 12 15 h 4</Geometry>
    <Geometry x:Key="Keep.IconLogs">M 6 3 h 9 l 4 4 v 14 H 6 Z M 9 11 h 7 M 9 15 h 7</Geometry>
    <Geometry x:Key="Keep.IconMap">M 3 6 l 6 -2 l 6 2 l 6 -2 v 14 l -6 2 l -6 -2 l -6 2 Z M 9 4 v 14 M 15 6 v 14</Geometry>
    <Geometry x:Key="Keep.IconEncyclopedia">M 5 4 h 10 a 3 3 0 0 1 3 3 v 13 H 8 a 3 3 0 0 1 -3 -3 Z M 5 17 a 3 3 0 0 1 3 -3 h 10</Geometry>
    <Geometry x:Key="Keep.IconGuides">M 12 21 a 9 9 0 1 0 0 -18 a 9 9 0 0 0 0 18 Z M 9.5 9.5 a 2.5 2.5 0 1 1 5 0.5 c 0 1.5 -2.5 2 -2.5 3.5 M 12 17 v 0.01</Geometry>
    <!-- Send my logs (an upload tray) and More (three dots), for the 64 px sidebar. -->
    <Geometry x:Key="Keep.IconSend">M 12 15 V 4 M 7 9 l 5 -5 l 5 5 M 4 15 v 5 h 16 v -5</Geometry>
    <Geometry x:Key="Keep.IconMore">M 4 12 a 1.5 1.5 0 1 0 3 0 a 1.5 1.5 0 1 0 -3 0 Z M 10.5 12 a 1.5 1.5 0 1 0 3 0 a 1.5 1.5 0 1 0 -3 0 Z M 17 12 a 1.5 1.5 0 1 0 3 0 a 1.5 1.5 0 1 0 -3 0 Z</Geometry>
    <!-- The banner of the tool icons (assets/icons/*.svg, 128 x 128), filled with Keep.ToolAccent as the sidebar brand mark. -->
    <Geometry x:Key="Keep.IconBanner">M 24 15 H 104 V 108 L 64 92 L 24 108 Z</Geometry>

    <!-- The window frame: sidebar, page buttons, header and page title (build-plan.md 1.3). -->
    <Style x:Key="Keep.Sidebar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.SidebarBack}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <!-- A page button: icon (NavRail.Icon) and word, the tool colour edge when NavRail.Selected, only the icon when NavRail.IsCompact. -->
    <Style x:Key="Keep.Nav" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.NavText}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel x:Name="Row" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                <Viewbox x:Name="IconBox" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding (ui:NavRail.Icon), RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Margin="0,7" CornerRadius="1.5" Background="{DynamicResource Keep.ToolEdge}" Visibility="Collapsed"/>
                        <Border x:Name="Ring" BorderBrush="{StaticResource Keep.FocusRing}" BorderThickness="2" CornerRadius="7" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:NavRail.Icon" Value="{x:Null}">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Keep.GoldInk}"/>
                        </MultiTrigger>
                        <Trigger Property="ui:NavRail.Selected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.NavSelected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.NavSelectedLine}"/>
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Keep.GoldInk}"/>
                        </Trigger>
                        <Trigger Property="ui:NavRail.IsCompact" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconBox" Property="Margin" Value="0"/>
                            <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.HeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Keep.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="24,8"/>
    </Style>
    <Style x:Key="Keep.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Frame buttons: at least 36 px tall, rounded, with a gold ring when the keyboard is on them.
         Ghost is the base; Primary (blue), Danger (red), Gold (Add mods) and State (the 48 px Start or Stop button) change its colours. -->
    <Style x:Key="Keep.BtnGhost" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.BorderDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{StaticResource Keep.FocusRing}" BorderThickness="2" CornerRadius="8" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.BgHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Keep.BtnPrimary" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="{StaticResource Keep.GoldButton}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.GoldButtonHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Keep.BtnDanger" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="{StaticResource Keep.RedSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.OnDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.DangerLine}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.DangerHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Keep.BtnGold" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="{StaticResource Keep.WarningSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.GoldInk}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.GoldInk}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.GoldInk}"/>
                <Setter Property="Foreground" Value="#FF1A160C"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Solid gold (Join on Discord on the Join my server card, redesign D2); red in the Realm of Thrones colours. -->
    <Style x:Key="Keep.BtnSolidGold" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="{StaticResource Keep.SolidFill}"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.OnSolid}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Keep.SolidFill}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.SolidFillHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- The one big button of a page (Start server, Connect): 48 px, green to go; Keep.BtnStateStop is the red Stop. -->
    <Style x:Key="Keep.BtnState" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="{StaticResource Keep.GoFill}"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Padding" Value="28,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.GoFillHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Keep.BtnStateStop" TargetType="Button" BasedOn="{StaticResource Keep.BtnState}">
        <Setter Property="Background" Value="{StaticResource Keep.StopFill}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Keep.StopFillHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A small text link (Join my server in the sidebar footer, Open full log). -->
    <Style x:Key="Keep.BtnLink" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Keep.GoldInk}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Keep.LinkHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A dark drop down menu for a More button (the Mods page). -->
    <Style x:Key="Keep.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.Placement" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" Padding="14,9" MinWidth="220">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.Menu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Keep.MenuItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Keep.BgRaised}" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1" CornerRadius="6" Padding="0,4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The on and off switch of a mod row (36 x 18 track, the Modules page switch). Space toggles it. -->
    <Style x:Key="Keep.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Width="36" Height="18" CornerRadius="9" Background="{StaticResource Keep.BorderDim}">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Keep.TextMain}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <Border x:Name="Ring" Margin="-3" BorderBrush="{StaticResource Keep.FocusRing}" BorderThickness="2" CornerRadius="12" Visibility="Hidden" IsHitTestVisible="False"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Keep.Accent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Keep.BgInput}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The mod list rows of every tool (ModRowLayout). Selecting a row does nothing, so there is no selected look: the
         mouse gives a quiet border and a row reached with the keyboard gets the dashed focus ring (WPF only draws a
         FocusVisualStyle for keyboard focus, never after a click). -->
    <Style x:Key="Keep.ModRowFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#FFE2C27A" BorderThickness="2" CornerRadius="6" Margin="-1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Keep.ModRowItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Keep.ModRowFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Keep.RowHoverLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
