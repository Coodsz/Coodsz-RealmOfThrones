<UserControl x:Class="Coodsz.Ui.SaveModsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI" Visibility="Collapsed">
    <!--
        The card for a save that needs mods the setup leaves out (SaveModCard in Core): a short title
        with the count, one line of why, the mods as chips with their friendly names and +N more, and
        one main button that fixes it. Coodsz Coop Server Tool shows it on Home and under Server controls (the
        AD1259 build too); the TAOM server tool shows it in its own box (linked there from this folder).
        The colours are the Keep. brushes, so each tool shows it in its own colours.
    -->
    <UserControl.Resources>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Keep.TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Keep.AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Keep.Card}" BorderBrush="{StaticResource Keep.Warning}" BorderThickness="3,1,1,1" Padding="16,14">
        <StackPanel>
            <DockPanel>
                <Button x:Name="DismissButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Dismiss" Tag="dismiss" Click="Command_Click" Margin="16,0,0,0" VerticalAlignment="Top"/>
                <Path DockPanel.Dock="Left" Data="M 8 1 L 15 14 L 1 14 Z M 8 6 L 8 9.5 M 8 11.5 L 8 12" Stroke="{StaticResource Keep.Warning}" StrokeThickness="1.4" StrokeLineJoin="Round"
                      Width="16" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource Keep.H2}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="WhyText" Style="{StaticResource Keep.Dim}" FontSize="13.5" TextWrapping="Wrap" Margin="26,4,0,12"/>
            <WrapPanel x:Name="ChipPanel" Margin="0,0,0,4"/>
            <TextBlock x:Name="NoteText" Foreground="{StaticResource Keep.Warning}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" Visibility="Collapsed"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="FixButton" Style="{StaticResource Keep.Gold}" Padding="18,8" Tag="fix" Click="Command_Click" Margin="0,0,18,0"/>
                <Button x:Name="OtherSaveButton" Style="{StaticResource Link}" Foreground="{StaticResource Keep.Accent}" Content="Use a different save" Tag="othersave" Click="Command_Click" Margin="0,0,18,0"/>
                <Button x:Name="AnywayButton" Style="{StaticResource Link}" Content="Start anyway" Tag="anyway" Click="Command_Click" Visibility="Collapsed"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
