<UserControl x:Class="Coodsz.Ui.MoveButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Move up and Move down for a mod row, so the load order changes without dragging (WCAG 2.5.7). -->
    <StackPanel Orientation="Horizontal">
        <Button x:Name="UpButton" Width="32" Height="32" Padding="0" Margin="0,0,4,0" Style="{DynamicResource Keep.BtnGhost}" Click="Up_Click" ToolTip="Moves this mod up one place in the load order.">
            <Path Data="M 2 9 L 7 4 L 12 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="14" Height="12"/>
        </Button>
        <Button x:Name="DownButton" Width="32" Height="32" Padding="0" Style="{DynamicResource Keep.BtnGhost}" Click="Down_Click" ToolTip="Moves this mod down one place in the load order.">
            <Path Data="M 2 4 L 7 9 L 12 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="14" Height="12"/>
        </Button>
    </StackPanel>
</UserControl>
