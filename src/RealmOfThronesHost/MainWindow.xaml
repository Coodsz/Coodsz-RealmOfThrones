                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Keep.AmberSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
