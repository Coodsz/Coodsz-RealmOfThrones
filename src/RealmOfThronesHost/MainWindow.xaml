                                        <TextBlock Text="Address" Foreground="{DynamicResource Keep.TextDim}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ServerAddressBox" Width="220" Height="34" LostFocus="ServerAddress_LostFocus" ToolTip="Clear this or type the address friends should use."/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Password" Foreground="{DynamicResource Keep.TextDim}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PasswordBox" ToolTip="Friends must type this password to join. Leave it blank for no password." Width="160" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="UDP port" Foreground="{DynamicResource Keep.TextDim}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Width="90" Height="34" Text="4200" IsReadOnly="True" ToolTip="The UDP port friends connect on. It is fixed at 4200."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SteamBox" ToolTip="Also lists the server through Steam so friends can join with your Steam name. Used when the server starts." Content="Advertise through Steam" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Keep.TextDim}" FontSize="13" TextWrapping="Wrap" Text="Leave Advertise through Steam off unless friends join through Steam with your Steam name. Everyone else joins on UDP port 4200."/>
                            </StackPanel>
                        </Border>
                        <Expander Style="{StaticResource SettingFold}" IsExpanded="True" AutomationProperties.AutomationId="SettingTime">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Game speed" FontFamily="Palatino Linotype" FontSize="20" Foreground="{DynamicResource Keep.TextMain}"/>
                                    <TextBlock Text="2x speed on the campaign map. Press Save settings, then restart the server so the new speed applies." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,4,28,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel VerticalAlignment="Top">
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="FastForwardBox" ToolTip="On lets the host and every player use fast forward. Click Save settings and restart the server to use it." DockPanel.Dock="Right" Content="On" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" AutomationProperties.AutomationId="FastForwardBox"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Host and players can fast forward" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="On means the fast forward button works for you and for every player. Off means you and every player stay at normal speed." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="BattleSpeedLimitBox" ToolTip="On keeps time at normal speed while any player is in a battle. Click Save settings and restart the server to use it." DockPanel.Dock="Right" Content="On" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" AutomationProperties.AutomationId="BattleSpeedLimitBox"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Stay at normal speed during a player battle" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="On means fast forward stops while any player is in a battle. Off means time can speed up during those battles." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource Primary}" Content="Save settings" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveGameSpeed" ToolTip="Saves every setting on this page. Restart the server to use them."/>
                            </StackPanel>
                        </Expander>
                        <Expander Style="{StaticResource SettingFold}" IsExpanded="True" AutomationProperties.AutomationId="SettingHost">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Host" FontFamily="Palatino Linotype" FontSize="20" Foreground="{DynamicResource Keep.TextMain}"/>
                                    <TextBlock Text="How often the campaign is saved, and whether the server writes a log." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,4,28,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel VerticalAlignment="Top">
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <TextBox x:Name="AutosaveBox" ToolTip="Minutes between autosaves, from 0 to 1440. 0 turns autosave off." DockPanel.Dock="Right" Width="140" Height="36" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" Background="{DynamicResource Keep.BgInput}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" CaretBrush="{DynamicResource Keep.TextMain}" Padding="8,6" AutomationProperties.AutomationId="AutosaveBox"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Autosave minutes" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="How many minutes pass before the server writes the campaign again. 0 turns autosave off. Use a whole number from 0 to 1440." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="LogFileBox" ToolTip="On makes the server write a log you can read later." DockPanel.Dock="Right" Content="On" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Write server log" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Keeps a log of what the host does. Leave this on if you want to read the server log later." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource Primary}" Content="Save settings" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveSettings" ToolTip="Saves every setting on this page. Restart the server to use them."/>
                            </StackPanel>
                        </Expander>
                        <StackPanel x:Name="GameplayPanel" VerticalAlignment="Top"/>
                        <!-- Advanced (closed): server rules, the Coop Server Tool's controls and defaults (MainWindow.ServerRules.cs). The defaults need no setup. -->
                        <Expander Style="{StaticResource SettingFold}" AutomationProperties.AutomationId="SettingServerRules">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Advanced: server rules" FontFamily="Palatino Linotype" FontSize="20" Foreground="{DynamicResource Keep.TextMain}"/>
                                    <TextBlock Text="Who may use coop.unstuck, pausing the game while a player joins, freezing the skill XP of offline players, and protecting player kingdoms from AI wars. The defaults work without setup." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,4,28,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel VerticalAlignment="Top">
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <ComboBox x:Name="UnstuckBox" Style="{StaticResource SettingChoice}" Width="300" Height="36" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Who may use coop.unstuck. Press Save settings to keep it." AutomationProperties.AutomationId="UnstuckBox"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Unstuck for players" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock FontFamily="Segoe UI" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Allowed is Coop's own behaviour. The middle choice stops players from using unstuck to escape a fight: not as a prisoner, in a battle or siege, while their army fights, with enemies nearby, or again within 5 minutes. " Foreground="{DynamicResource Keep.TextDim}"/><Run Text="Host only leaves it to you: coop.unstuck with the player's id on the Console page." Foreground="{DynamicResource Keep.TextMain}"/></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="PauseOnJoinBox" IsChecked="True" DockPanel.Dock="Right" Content="On" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" AutomationProperties.AutomationId="PauseOnJoinBox" ToolTip="Pauses the game while a player joins or loads, and puts your speed back when they are on the map. It lets go after 3 minutes, and a player who was on the map once never pauses it again this session."/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Pause the game while a player joins" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Pauses the game while a player joins or loads, and puts your speed back when they are on the map. It lets go after 3 minutes, and a player who was on the map once never pauses it again this session." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <CheckBox x:Name="FreezeOfflineXpBox" IsChecked="True" DockPanel.Dock="Right" Content="On" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" AutomationProperties.AutomationId="FreezeOfflineXpBox" ToolTip="Players who are offline gain no skill XP until they come back. Coop already freezes their gold and food."/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Freeze the skill XP of offline players" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Players who are offline gain no skill XP until they come back. Coop already freezes their gold and food." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <DockPanel LastChildFill="True">
                                        <ComboBox x:Name="KingdomProtectionBox" Style="{StaticResource SettingChoice}" Width="300" Height="36" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="When AI kingdoms may start a war with a kingdom players are in. Press Save settings to keep it." AutomationProperties.AutomationId="KingdomProtectionBox"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Protect player kingdoms from AI wars" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock FontFamily="Segoe UI" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Only while their players are offline is Coop's own protection. Always also covers kingdoms whose players are online, and vassals as well as rulers. " Foreground="{DynamicResource Keep.TextDim}"/><Run Text="Wars your players start, a player attacking first and rebellions still happen." Foreground="{DynamicResource Keep.TextMain}"/></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="Saved in coodsz-server-tools.json next to server-config.json. The server uses the unstuck, XP and Always rules within a few seconds, and players need nothing. Switching between the other kingdom choices needs a server restart." TextWrapping="Wrap" Foreground="{DynamicResource Keep.TextDim}" FontSize="13" Margin="0,10,0,0"/>
                                <Button Style="{StaticResource Primary}" Content="Save settings" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click" AutomationProperties.AutomationId="SaveServerRules" ToolTip="Saves every setting on this page. Restart the server to use them."/>
                            </StackPanel>
                        </Expander>
                        <!-- Advanced (closed): the mod settings players get (MainWindow.ModSettings.cs). MCM's provider does not run on the Realm of Thrones server, so the sync sends the server's own copy of the MCM files (ServerModSettings), which takes this PC's files it is missing. -->
                        <Expander Style="{StaticResource SettingFold}" AutomationProperties.AutomationId="SettingModSettings">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Advanced: mod settings for players" FontFamily="Palatino Linotype" FontSize="20" Foreground="{DynamicResource Keep.TextMain}"/>
                                    <TextBlock Text="Players who join with a Coodsz launcher use your MCM settings for the session, so every PC runs the mods the same way. Their own files are never changed." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,4,28,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="ModSettingsNote" Text="The server keeps its own copy of your MCM settings. Change a value here and players get it within a few seconds. Mods you did not change or import here follow your own game's MCM each time you open this page or start the server. The ones you changed stay as you set them until you click Back to this PC's values." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <!-- No MCM files on the server or this PC yet: Import comes first, so a dedicated server host finds it. -->
                                <Border x:Name="ModSettingsEmpty" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ModSettingsEmpty">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No mod settings yet" Style="{StaticResource SectionTitle}" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Import the mod settings a player sends you, a .zip or a folder. Or set the mods up in MCM in your own game, then open this page again." FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,12"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource Primary}" Content="Import mod settings" Click="ImportModSettingsZip_Click" Margin="0,0,8,0" AutomationProperties.AutomationId="ImportModSettingsEmpty" ToolTip="Pick the .zip a player sent you. Only the Global MCM files of mods this server has are taken."/>
                                            <Button Style="{StaticResource Ghost}" Content="Import a folder" Click="ImportModSettingsFolder_Click" ToolTip="Pick the folder a player sent you, such as their Configs\ModSettings folder. Only the Global MCM files of mods this server has are taken."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Grid x:Name="ModSettingsEditor" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="ModSettingsMods" MaxHeight="420" SelectionChanged="ModSettingsMods_SelectionChanged" AutomationProperties.AutomationId="ModSettingsMods" Background="{DynamicResource Keep.BgInput}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}"/>
                                    <ScrollViewer Grid.Column="1" MaxHeight="420" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="ModSettingsValues"/>
                                    </ScrollViewer>
                                </Grid>
                                <WrapPanel x:Name="ModSettingsButtons" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button x:Name="ModSettingsSave" Style="{StaticResource Primary}" Content="Save" Margin="0,0,8,8" Click="SaveModSettings_Click" AutomationProperties.AutomationId="SaveModSettings" ToolTip="Saves this mod's values. Players get them within a few seconds."/>
                                    <Button Style="{StaticResource Ghost}" Content="Back to this PC's values" Margin="0,0,8,8" Click="ResetModSettings_Click" ToolTip="Puts this mod's values back to the ones MCM saved in your own game on this PC."/>
                                    <Button Style="{StaticResource Ghost}" Content="All mods back to this PC's values" Margin="0,0,8,8" Click="ResetAllModSettings_Click" ToolTip="Puts every mod back to the values MCM saved in your own game on this PC. Imported mods this PC has no file for are removed."/>
                                    <Button Style="{StaticResource Ghost}" Content="Import mod settings" Margin="0,0,8,8" Click="ImportModSettingsZip_Click" AutomationProperties.AutomationId="ImportModSettings" ToolTip="Pick the .zip a player sent you. Only the Global MCM files of mods this server has are taken."/>
                                    <Button Style="{StaticResource Ghost}" Content="Import a folder" Margin="0,0,8,8" Click="ImportModSettingsFolder_Click" ToolTip="Pick the folder a player sent you, such as their Configs\ModSettings folder. Only the Global MCM files of mods this server has are taken."/>
                                </WrapPanel>
                                <TextBlock x:Name="ModSettingsStatus" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextMain}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="ModSettingsStatus"/>
                                <TextBlock x:Name="ModSettingsWarning" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.Warning}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ModSettingsWarning"/>
                                <TextBlock Text="Settings a mod keeps per campaign are saved in the world and can only be changed in game." FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <!-- Advanced: the server folder and the Windows fixes. Unblock DLLs turns red when the log says Windows blocked a DLL. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Advanced: server folder" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource Ghost}" Content="Open server folder" ToolTip="Opens the server folder in File Explorer." Margin="0,0,6,6" Click="OpenFolder_Click"/>
                                    <Button Style="{StaticResource Ghost}" Content="Choose Coop server" Margin="0,0,6,6" Click="PickCoopServer_Click" AutomationProperties.AutomationId="ChooseCoopServer" ToolTip="Pick the folder of the unpacked Coop server. The server runs from that folder."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Advanced: Windows" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="UnblockButton" Style="{StaticResource Ghost}" Content="Unblock DLLs" Click="Unblock_Click" ToolTip="Clears the Windows download block on files in the server folder. This button turns red when the server log says Windows blocked a DLL." Margin="0,0,6,6"/>
                                    <Button Style="{StaticResource Ghost}" Content="Fix antivirus" Click="FixAntivirus_Click" AutomationProperties.AutomationId="FixAntivirus" ToolTip="Shows the folders your antivirus should skip on this PC and opens Windows Security. It changes no setting itself." Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Mods: the setup tools, one notice at a time, the toolbar, then the mod rows. The page title is in the header. -->
                <ScrollViewer x:Name="ModulesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Border.Resources>
                                <Style x:Key="BarPrimary" TargetType="Button" BasedOn="{StaticResource Keep.BtnPrimary}">
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                </Style>
                                <Style x:Key="BarGhost" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                </Style>
                                <Style x:Key="BarDanger" TargetType="Button" BasedOn="{StaticResource Keep.BtnDanger}">
                                    <Setter Property="Margin" Value="16,0,0,8"/>
                                </Style>
                                <!-- A notice line inside the page, the look of a Warn banner. -->
                                <Style x:Key="ModsWarnLine" TargetType="Border">
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="{StaticResource Keep.WarningSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Keep.GoldInk}"/>
                                </Style>
                            </Border.Resources>
                            <StackPanel>
                                <!-- The setup tools: the setup itself is picked in the header (ModSetupBox). -->
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <Button x:Name="DeleteModSetupButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="Delete" Style="{StaticResource BarDanger}" Click="DeleteModSetup_Click" ToolTip="Deletes this setup from the server tool. The locked Realm of Thrones setup cannot be deleted."/>
                                    <Button x:Name="RenameHostSetupButton" DockPanel.Dock="Right" Content="Rename" Style="{StaticResource BarGhost}" Margin="8,0,0,0" Click="RenameHostSetup_Click" ToolTip="Gives this setup a new name. Locked setups keep their name."/>
                                    <Button x:Name="CopyHostSetupButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource BarGhost}" Margin="8,0,0,0" Click="CopyHostSetup_Click" ToolTip="Makes a new setup with the same mods as this one. Copy a locked setup to change it."/>
                                    <Button x:Name="NewHostSetupButton" DockPanel.Dock="Right" Content="New setup" Style="{StaticResource BarGhost}" Margin="8,0,0,0" Click="NewHostSetup_Click" ToolTip="Makes a new setup with only the Realm of Thrones core. Then click Add mods."/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Mod setup" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center"/>
                                        <Border VerticalAlignment="Center" Margin="14,0,0,0" Padding="12,3" CornerRadius="12" Background="{DynamicResource Keep.SuccessSoft}" BorderBrush="{DynamicResource Keep.Success}" BorderThickness="1" ToolTip="Players need the same mods at the same versions to join.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ModuleSummaryText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Keep.Success}" VerticalAlignment="Center"/>
                                                <TextBlock Text="mods on" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Success}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel x:Name="RenameHostSetupPanel" Visibility="Collapsed" LastChildFill="True" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource BarGhost}" Margin="8,0,0,0" Click="CancelRenameHostSetup_Click" ToolTip="Closes the rename box and keeps the old name."/>
                                    <Button DockPanel.Dock="Right" Content="Save name" Style="{StaticResource BarPrimary}" ToolTip="Saves the new name for this setup." Margin="8,0,0,0" Click="SaveHostSetupName_Click"/>
                                    <TextBox x:Name="HostSetupNameBox" Height="34" FontSize="15" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource Keep.BgInput}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" CaretBrush="{DynamicResource Keep.TextMain}" KeyDown="HostSetupNameBox_KeyDown" ToolTip="Type the new name of this setup."/>
                                </DockPanel>
                                <!-- One notice at a time: the running block beats the save hint, then the other lines (BannerStack.Priority). -->
                                <ui:BannerStack x:Name="ModsNotices" MaxShown="1" Margin="0,0,0,4">
                                    <ui:Banner x:Name="ModsRunningBanner" Kind="Warn" Visibility="Collapsed" Margin="0,0,0,8" ui:BannerStack.Priority="0"/>
                                    <TextBlock x:Name="HostModsSaveHint" Text="You changed the mods. Click Save mods to keep the changes." Visibility="Collapsed" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Keep.Warning}" ui:BannerStack.Priority="1"/>
                                    <TextBlock x:Name="ModSetupStatus" AutomationProperties.AutomationId="ModSetupStatus" Visibility="Collapsed" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Keep.TextDim}" ui:BannerStack.Priority="2"/>
                                    <Border x:Name="ExtrasNotLoadedBar" Visibility="Collapsed" Style="{StaticResource ModsWarnLine}" ui:BannerStack.Priority="3">
                                        <TextBlock x:Name="ExtrasNotLoadedText" TextWrapping="Wrap" Foreground="{DynamicResource Keep.Amber}" FontSize="15" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="ShareModListHint" Text="Players need the same mods in the same order. Click Share mod list and send it to them." Visibility="Collapsed" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Keep.Amber}" ui:BannerStack.Priority="4"/>
                                </ui:BannerStack>
                                <!-- The toolbar, with the full mod list link at its end, before the grey line. -->
                                <WrapPanel x:Name="ModuleToolbar">
                                    <Button x:Name="AddHostModsButton" Content="Add mods" Style="{StaticResource Keep.BtnGold}" Margin="0,0,8,8" Click="AddHostMods_Click" ToolTip="Picks mods already on this PC, from the Steam Workshop or the game's Modules folder."/>
                                    <Button x:Name="SaveHostModsButton" Content="Save mods" Style="{StaticResource BarPrimary}" Click="SaveHostMods_Click" ToolTip="Keeps the mod changes on this setup. Start server uses the saved list."/>
                                    <Button x:Name="InstallHostModsButton" Content="Install mods" Style="{StaticResource BarPrimary}" Click="InstallHostMods_Click" ToolTip="Downloads the extra Workshop mods of this setup that are not on this PC yet, so Start server can copy them to the server."/>
                                    <Button x:Name="ModsMoreButton" Style="{StaticResource BarGhost}" Content="More ▾" Click="ModsMore_Click" ToolTip="Import mod list, Share mod list and Auto sort.">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource Keep.Menu}">
                                                <MenuItem x:Name="ImportListItem" Header="Import mod list" Click="ImportModList_Click" ToolTip="Opens a mod list file a player shared from the client launcher."/>
                                                <MenuItem Header="Share mod list" Click="ShareModList_Click" ToolTip="Saves this setup to a mod list file. Players click Import mod list in the client launcher."/>
                                                <MenuItem x:Name="AutoSortHostButton" Header="Auto sort" Click="AutoSortHost_Click" ToolTip="Auto sort can move the Realm of Thrones group past extra mods. The four modules stay together."/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="ModWarning" AutomationProperties.AutomationId="ModWarning" Text="The Realm of Thrones core always loads as it is. Extra mods come from the mod setup below." Foreground="{DynamicResource Keep.TextDim}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0" ToolTip="Realm of Thrones Coop Compat always loads last."/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="OrderList" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Keep.TextMain}" Padding="0"
 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
 ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
 ItemContainerStyle="{StaticResource ModuleRow}" HorizontalContentAlignment="Stretch">
<ListBox.ItemsPanel>
<ItemsPanelTemplate>
    <StackPanel/>
</ItemsPanelTemplate>
</ListBox.ItemsPanel>
<ListBox.ItemTemplate>
<DataTemplate>
    <!-- Fixed columns (ModRowLayout): the switch slot, the number, the name, the chip column and the button slot keep
         their width on every row, so a core row without the switch and the buttons lines up with an extra mod row. -->
    <Grid Background="Transparent" ToolTip="{Binding RowTip}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="{x:Static ui:ModRowLayout.SwitchColumn}" VerticalAlignment="Center">
            <CheckBox Style="{StaticResource Keep.Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding EditVisibility}" VerticalAlignment="Center" Cursor="Hand" Click="ToggleHostMod_Click" ToolTip="On loads this mod. Off keeps it on the setup without loading it."/>
        </Border>
        <Border Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Number}" Width="32" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.GoldInk}" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
        <StackPanel Grid.Column="3" Width="{x:Static ui:ModRowLayout.ChipColumn}" VerticalAlignment="Center">
            <WrapPanel>
                <TextBlock Text="{Binding NoteText}" FontFamily="Segoe UI" FontSize="12" Foreground="{Binding NoteBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <!-- The list status chip from the Realm of Thrones list (an extra mod only), then this PC's own result. -->
                <Border Background="{Binding BadgeBack}" CornerRadius="9" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}" ToolTip="{Binding BadgeNote}">
                    <TextBlock Text="{Binding BadgeText}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeInk}"/>
                </Border>
                <Border Background="{Binding MineBackground}" BorderBrush="{Binding MineInk}" BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="{Binding MineOpacity}" Visibility="{Binding MineVisibility}" ToolTip="{Binding Mine.Tip}">
                    <TextBlock Text="{Binding Mine.Text}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MineInk}"/>
                </Border>
            </WrapPanel>
            <!-- What players reported (ModReportUi.CountChips, from the Realm of Thrones list) and the small Report link (ModReportUi.RowLink),
                 built in MainWindow.ReportChips. -->
            <ContentControl Content="{Binding Reports}" VerticalAlignment="Center" Focusable="False" IsTabStop="False"/>
        </StackPanel>
        <Border Grid.Column="4" Width="{x:Static ui:ModRowLayout.EditButtonsColumn}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding OrderActionsVisibility}">
                <Button Content="▲" Style="{StaticResource Ghost}" MinHeight="28" Padding="9,1" Margin="4,0,0,0" FontSize="12" IsEnabled="{Binding CanMove}" Click="MoveHostModUp_Click" ToolTip="Move up"/>
                <Button Content="▼" Style="{StaticResource Ghost}" MinHeight="28" Padding="9,1" Margin="4,0,0,0" FontSize="12" IsEnabled="{Binding CanMove}" Click="MoveHostModDown_Click" ToolTip="Move down"/>
                <Button Content="✕" Style="{StaticResource Ghost}" MinHeight="28" Padding="9,1" Margin="4,0,0,0" FontSize="12" Visibility="{Binding EditVisibility}" IsEnabled="{Binding CanEdit}" Click="RemoveHostMod_Click" ToolTip="Remove from this setup. The mod stays installed."/>
            </StackPanel>
        </Border>
    </Grid>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
                    </StackPanel>
                </ScrollViewer>
                <!-- Logs: the server log in the dark frame of the Dashboard's log card, the buttons in a card under it. -->
                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Background="{DynamicResource Keep.SidebarBack}" BorderBrush="{DynamicResource Keep.Line}">
                        <DockPanel>
                            <TextBlock Text="Live lines from the server. Commands stay on Console." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextDim}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Keep.SidebarBack}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>
                    </Border>
                    <!-- My reports shows beside Send my logs once a report was sent (ReportRepliesUi.AddMyReports). -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <WrapPanel>
                            <Button Content="Open server logs"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,8"
                                    Padding="14,8"
                                    FontFamily="Segoe UI"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource Keep.WarningSoft}"
                                    Foreground="{DynamicResource Keep.GoldInk}"
                                    BorderBrush="{DynamicResource Keep.GoldInk}"
                                    BorderThickness="2"
                                    Cursor="Hand"
                                    Template="{StaticResource HoverButton}"
                                    Click="OpenLogs_Click"
                                    ToolTip="Opens the logs folder and selects the newest coop-server log plus a dated host-action copy for Discord."/>
                            <Button x:Name="LogsSendLogsButton" Style="{StaticResource Ghost}" Content="Send my logs" Margin="0,0,8,8" Click="SendLogs_Click" ToolTip="Sending logs and reports is not set up yet for the Realm of Thrones tools."/>
                            <ContentControl x:Name="LogsMyReportsSlot" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </Border>
                </Grid>
                <Grid x:Name="ConsolePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- The output card's chips, command box and buttons take about 150 to 180 on their own, so this row's minimum keeps room for the output box (BE #14). -->
                        <RowDefinition Height="3*" MinHeight="280"/>
                        <RowDefinition Height="Auto"/>
                        <!-- The command browser's search box, Side pills and count line take about 130, so 175 still shows a line or two of commands. Both minimums together fit the 720 high window. -->
                        <RowDefinition Height="2*" MinHeight="175"/>
                    </Grid.RowDefinitions>
                    <!-- The page title (Console) is in the header; the reference link and the state line sit in a card over the backdrop. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Keep.TextDim}" FontSize="15">
                                <Run Text="What you send, the replies and the live server lines. Command reference: "/>
                                <Hyperlink Click="OpenCommandReference_Click" Foreground="{DynamicResource Keep.GoldInk}" TextDecorations="Underline">https://bannerlordcoop.com/cheats?tab=all</Hyperlink><Run Text=". Some commands can crash this host."/>
                            </TextBlock>
                            <TextBlock x:Name="ConsoleHint" TextWrapping="Wrap" Foreground="{DynamicResource Keep.TextMain}" FontSize="15" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Live server output, the command box and the recent commands, in a card so the tick boxes read over the backdrop. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" x:Name="RecentCommands" Margin="0,6,0,0" Tag="coodsz:no-translate"/>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Send" Click="Send_Click" ToolTip="Sends the command in the box to the server console. Enter does the same." AutomationProperties.AutomationId="SendCommand"/>
                                <TextBox x:Name="CommandBox" ToolTip="Type a server console command, then press Enter or click Send." KeyDown="CommandBox_KeyDown" AutomationProperties.AutomationId="CommandBox"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Ghost}" Content="Clear" Margin="0" Click="ClearConsole_Click" ToolTip="Clears this console box. It does not touch the server log."/>
                                <Button Style="{StaticResource Ghost}" Content="Copy" Margin="8,0,0,0" Click="CopyConsole_Click" ToolTip="Copies everything in this console box."/>
                                <CheckBox x:Name="AutoScroll" Content="Auto scroll" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Keeps the list scrolled to the newest line."/>
                                <CheckBox x:Name="ConsoleServerLines" Content="Show server output" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Shows the live server output in the list too, not only what you send."/>
                            </StackPanel>
                            <RichTextBox x:Name="HistoryBox" IsReadOnly="True" IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Keep.SidebarBack}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" FontFamily="Consolas" FontSize="13" AutomationProperties.AutomationId="HistoryBox">
                                <FlowDocument Background="{DynamicResource Keep.SidebarBack}" PagePadding="0" FontFamily="Consolas" FontSize="13"/>
                            </RichTextBox>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext"/>
                    <!-- Every Coop command from bannerlordcoop.com/cheats, shared with the Coop Server Tool (CoodszHost\Shared\CoopCommandBrowser.xaml) -->
                    <ui:CoopCommandBrowser x:Name="CommandBrowser" Grid.Row="3"/>
                </Grid>
                <!-- Cheats: player cards, category chips and one form per cheat. -->
                <local:CoopCheatsPage x:Name="CoopCheats" Visibility="Collapsed"/>
                <!-- Encyclopedia: the note, then one row per link of RotEncyclopedia (ShowEncyclopedia in MainWindow.Frame.cs). -->
                <ScrollViewer x:Name="EncyclopediaPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <TextBlock x:Name="EncyclopediaNote" FontFamily="Segoe UI" Foreground="{DynamicResource Keep.TextDim}" FontSize="14" TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="EncyclopediaList"/>
                                <TextBlock x:Name="EncyclopediaStatus" FontFamily="Segoe UI" Foreground="{DynamicResource Keep.TextDim}" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed" Tag="coodsz:no-translate"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Guides: the tool's own help pages (TaomGuidesPage, filled the first time it opens). -->
                <ContentControl x:Name="GuidesPage" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
