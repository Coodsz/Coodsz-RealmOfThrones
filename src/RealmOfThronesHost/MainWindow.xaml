                            </Border>
                            <Border Margin="0,0,14,0" CornerRadius="8" BorderBrush="#FF4F8A62" BorderThickness="1" Height="132" ClipToBounds="True">
                                <Grid>
                                    <Image Source="/Assets/realm-tile-2.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#D0061109" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                    <TextBlock Text="Weekly tournaments" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Bottom" Margin="12,0,0,9"/>
                                </Grid>
                            </Border>
                            <Border Margin="0,0,14,0" CornerRadius="8" BorderBrush="#FF4F8A62" BorderThickness="1" Height="132" ClipToBounds="True">
                                <Grid>
                                    <Image Source="/Assets/realm-tile-3.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#D0061109" Offset="1"/></LinearGradientBrush></Border.Background></Border>
