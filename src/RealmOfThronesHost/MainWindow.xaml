                                    <Border Background="#CC0F2A1C" BorderBrush="#FF3F7A52" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="0,0,7,7"><TextBlock FontSize="14"><Run Text="⚔ " FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="{DynamicResource Keep.GoldInk}"/><Run Text="Events every Saturday" Foreground="#FFE6EFE8"/></TextBlock></Border>
