<Window x:Class="RealmOfThronesHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RealmOfThronesHost"
        xmlns:ui="clr-namespace:Coodsz.Ui"
        Title="Coodsz Realm of Thrones Server Tool" Height="900" Width="1280"
        MinHeight="720" MinWidth="900"
        Background="{DynamicResource Keep.BgDeep}" Foreground="{DynamicResource Keep.TextMain}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Crash reports (CrashReportUi in CrashReportWindow.cs): the red of a failed start, the gold of the buttons and the green of the heading. -->
        <StaticResource x:Key="ReportRed" ResourceKey="Keep.Red"/>
        <StaticResource x:Key="ReportRedBack" ResourceKey="Keep.BadSoft"/>
        <StaticResource x:Key="ReportGold" ResourceKey="Keep.GoldInk"/>
        <StaticResource x:Key="ReportGoldBack" ResourceKey="Keep.InfoSoft"/>
        <StaticResource x:Key="ReportGreen" ResourceKey="Keep.Success"/>
        <StaticResource x:Key="ReportGreenBack" ResourceKey="Keep.SuccessSoft"/>
        <StaticResource x:Key="ReportInk" ResourceKey="Keep.BgDeep"/>
        <!-- The Coop Server Tool's buttons, cards and boxes in the Keep colours (redesign wave 6), under the names this window's
             elements already use, so every element keeps its own attributes. -->
        <ControlTemplate x:Key="HoverButton" TargetType="Button">
            <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                    <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Palatino Linotype"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Keep.AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Keep.GoldButtonHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Steady, without the old pulse (redesign plan 6.14). -->
        <Style x:Key="UpdateInstall" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="{DynamicResource Keep.AmberSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.WarningInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.Amber}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Keep.BgRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Keep.BgHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Danger" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Keep.RedSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.OnDanger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.DangerLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Keep.DangerHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="Margin" Value="0,6,16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Edge" BorderBrush="Transparent" BorderThickness="2" Padding="4,2" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" Background="{DynamicResource Keep.BgInput}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="Mark" Data="M 2 8 L 6 12 L 14 3" Stroke="{DynamicResource Keep.Accent}" StrokeThickness="1.6" Visibility="Collapsed" Margin="0,1,0,0"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Keep.BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.Line}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Keep.TextMain}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Keep.BgRaised}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A mod row of the Mods page: a near solid card of its own, like the Coop Server Tool's rows. -->
        <Style x:Key="ModuleRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Every row the same height with its content centred, and the dashed focus ring only for keyboard focus (ModRowLayout). -->
            <Setter Property="MinHeight" Value="{x:Static ui:ModRowLayout.RowHeight}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Keep.ModRowFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{DynamicResource Keep.PanelGradient}" BorderBrush="{DynamicResource Keep.Line}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Keep.RowHoverLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid>
                            <Border x:Name="ItemBorder" Background="{DynamicResource Keep.BgInput}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="HoverEdge" BorderBrush="{DynamicResource Keep.GoldInk}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HoverEdge" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Keep.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Keep.BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.BorderDim}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SaveItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxEdge" Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.Line}" BorderThickness="1" MinHeight="34">
                                            <DockPanel LastChildFill="True" Margin="10,0,10,0">
                                                <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Keep.Accent}" StrokeThickness="1.4" Width="8" Height="4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedItem.PlaceText, RelativeSource={RelativeSource AncestorType=ComboBox}}" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" FontFamily="Segoe UI" FontSize="16" Foreground="{DynamicResource Keep.TextMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxEdge" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="BoxEdge" Property="BorderBrush" Value="{DynamicResource Keep.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A Settings group: a near solid Keep card with its heading inside, open or closed by the heading. -->
        <Style x:Key="SettingFold" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="Background" Value="{DynamicResource Keep.PanelGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Top">
                                <ToggleButton Cursor="Hand" Focusable="False" Padding="16,14" HorizontalAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Hover" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                                                <DockPanel Margin="{TemplateBinding Padding}">
                                                    <TextBlock DockPanel.Dock="Right" FontFamily="Segoe UI" FontSize="18" Foreground="{DynamicResource Keep.Accent}" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▸"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                        <Setter Property="Text" Value="▾"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Margin="16,4,16,12" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Keep.BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <!-- Near solid (94%), so text on a card keeps its contrast over the picture behind the pages. -->
            <Setter Property="Background" Value="{DynamicResource Keep.PanelGradient}"/>
        </Style>
        <!-- Dark dropdown for the header's mod setup and the Settings page (campaign difficulty). -->
        <Style x:Key="SettingChoice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Keep.TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{DynamicResource Keep.BgInput}" Padding="10,7">
                                        <ContentPresenter TextElement.Foreground="{DynamicResource Keep.TextMain}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Keep.BgRaised}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Keep.AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxEdge" Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.Line}" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Keep.Accent}" StrokeThickness="1.4" Width="8" Height="4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxEdge" Property="BorderBrush" Value="{DynamicResource Keep.GoldInk}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource Keep.TextMain}"/>
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Every scroll bar of the window in the thin dark Keep look, not the light Windows one. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 220 wide, or 64 with icons only under 1000 px (NavRail.Fit in MainWindow.xaml.cs). -->
            <ColumnDefinition x:Name="NavColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Keep.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,18,12,12">
                    <DockPanel Margin="4,0,0,0">
                        <!-- The brand mark: the banner of the tool icon, a dark wine fill (Keep.BrandFill) so it shows on the black sidebar, with the red edge and crown. -->
                        <Viewbox x:Name="BrandMark" DockPanel.Dock="Left" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Canvas Width="128" Height="128">
                                <Path Data="{StaticResource Keep.IconBanner}" Fill="{DynamicResource Keep.BrandFill}" Stroke="{DynamicResource Keep.ToolEdge}" StrokeThickness="6"/>
                                <Path Data="M 52 32 V 22 L 58 27 L 64 18 L 70 27 L 76 22 V 32 Z" Fill="{DynamicResource Keep.CardHeading}"/>
                            </Canvas>
                        </Viewbox>
                        <!-- COODSZ big in the serif font, the tool name small and in capitals under it. -->
                        <StackPanel x:Name="BrandText" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandWord" Text="COODSZ" FontFamily="Palatino Linotype" FontSize="22" FontWeight="Normal" Foreground="{DynamicResource Keep.TextMain}" Tag="coodsz:no-translate"/>
                            <TextBlock x:Name="ToolHeading" Text="REALM OF THRONES SERVER TOOL" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextDim}" Margin="1,1,0,0" TextWrapping="Wrap" Tag="coodsz:no-translate"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Send my logs (CrashReportUi): on every page, for a crash, a stuck join, a desync or lag. -->
                    <ContentControl x:Name="SendLogsSlot" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                    <!-- Send my logs as an icon in the 64 px sidebar (ShowCompactSidebar). -->
                    <Button x:Name="SendLogsCompact" AutomationProperties.Name="Send my logs" Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSend}" Visibility="Collapsed" Margin="0,10,0,0" Click="SendLogs_Click" ToolTip="Stuck joining, a desync, lag or something else? Sends your cleaned logs to Coodsz and gives you a short code to post in Discord. You see every file before anything is sent."/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Keep.Line}" BorderThickness="0,1,0,0" Margin="12,0,12,12" Padding="0,10,0,0">
                    <Grid>
                        <!-- The 64 px sidebar shows a More button instead (CompactMore_Click opens Language, What's new, Donate and Join my server). -->
                        <Button x:Name="CompactMore" AutomationProperties.Name="More" Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconMore}" Visibility="Collapsed" Click="CompactMore_Click" ToolTip="Language, What's new, Donate and Join my server."/>
                        <Viewbox x:Name="FooterFit" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel>
                                <ContentControl x:Name="LanguageSlot" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                <ContentControl x:Name="WhatsNewSlot" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <ContentControl x:Name="DonateSlot" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <!-- The Realm promo as a small link plus the Dashboard card, as in the Coop Server Tool (build-plan.md 7). -->
                                <Button x:Name="RealmLink" Style="{StaticResource Keep.BtnLink}" Content="Join my server" Tag="Realm" Click="Nav_Click" Margin="0,8,0,0" ToolTip="The Realm Bannerlord, my custom modded server"/>
                                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Keep.TextDim}" FontSize="11" HorizontalAlignment="Left" Margin="6,8,0,0" Text="Realm of Thrones 8.1.8"/>
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <!-- The page buttons sit at the top in a list that scrolls on a short window. -->
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="NavList" VerticalAlignment="Top" Margin="12,0">
                        <Button x:Name="NavDashboard" ToolTip="Shows the Dashboard with Start server, the server state, the addresses and who is online." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconDashboard}" Content="Dashboard" Tag="Dashboard" Click="Nav_Click" AutomationProperties.AutomationId="NavDashboard"/>
                        <!-- Saves keeps the Tag Server, so every ShowPage("Server") still opens it. -->
                        <Button x:Name="NavServer" ToolTip="Shows the Saves page with the campaign save, Prepare server and the save backups." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSaves}" Content="Saves" Tag="Server" Click="Nav_Click" AutomationProperties.AutomationId="NavServer"/>
                        <Button x:Name="NavModules" ToolTip="Pick the mod setup the server loads and add or remove mods." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconMods}" Content="Mods" Tag="Modules" Click="Nav_Click" AutomationProperties.AutomationId="NavModules"/>
                        <Button x:Name="NavSettings" ToolTip="Game speed, autosave, battle size and campaign difficulty." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSettings}" Content="Settings" Tag="Settings" Click="Nav_Click" AutomationProperties.AutomationId="NavSettings"/>
                        <Button x:Name="NavCheats" ToolTip="Set gold, give influence and send saved console commands to players." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconCheats}" Content="Cheats" Tag="Cheats" Click="Nav_Click" AutomationProperties.AutomationId="NavCheats"/>
                        <Button x:Name="NavConsole" ToolTip="Type server console commands and see the replies." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconConsole}" Content="Console" Tag="Console" Click="Nav_Click" AutomationProperties.AutomationId="NavConsole"/>
                        <Button x:Name="NavLogs" ToolTip="Shows the live lines from the server log." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconLogs}" Content="Logs" Tag="Logs" Click="Nav_Click" AutomationProperties.AutomationId="NavLogs"/>
                        <Button x:Name="NavEncyclopedia" ToolTip="Links to the Realm of Thrones wiki and tables of troops, gear, cultures, kingdoms and clans." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconEncyclopedia}" Content="Encyclopedia" Tag="Encyclopedia" Click="Nav_Click" AutomationProperties.AutomationId="NavEncyclopedia"/>
                        <Button x:Name="NavGuides" ToolTip="Short help pages for hosting with this tool." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconGuides}" Content="Guides" Tag="Guides" Click="Nav_Click" AutomationProperties.AutomationId="NavGuides"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <!-- The header: page title, the mod setup picker (ModSetupBox, the setup Start server uses), the state pill and the clock. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Keep.HeaderBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Grid.Column="0" Style="{StaticResource Keep.PageTitle}" Text="Dashboard"/>
                    <StackPanel Grid.Column="1" Margin="16,0,8,0" Width="280" VerticalAlignment="Center">
                        <!-- The Locked tag sits on the label line, so it does not take width from the setup name. -->
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Mod setup" Foreground="{DynamicResource Keep.TextDim}" FontSize="11" VerticalAlignment="Center"/>
                            <Border x:Name="LockedSetupTag" DockPanel.Dock="Left" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,0" CornerRadius="0" Background="{DynamicResource Keep.BgRaised}" BorderBrush="{DynamicResource Keep.Amber}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontFamily="Segoe UI Emoji" FontSize="12" Foreground="{DynamicResource Keep.Amber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Locked" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Amber}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <ComboBox x:Name="ModSetupBox" Style="{StaticResource SettingChoice}" Height="34" HorizontalAlignment="Stretch" SelectionChanged="ModSetupBox_SelectionChanged" ToolTip="The mod setup players should use to join this server."/>
                        <TextBlock x:Name="LockedSetupText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Amber}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <!-- While the server runs: picking a setup is for the next Start, the mods stay blocked (ApplyModListBlock). -->
                        <TextBlock x:Name="SetupRunningNote" Visibility="Collapsed" Text="Changes what the next Start uses." FontSize="11" Foreground="{DynamicResource Keep.TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ui:StatusPill x:Name="StatePill" Kind="Stopped" Text="Stopped" ToolTip="What the server is doing now."/>
                        <!-- The older state word and dot stay for the code that sets them; the pill says the same. -->
                        <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource Keep.Amber}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StateText" Text="STOPPED" FontWeight="Bold" Foreground="{DynamicResource Keep.Amber}"/>
                        </StackPanel>
                        <!-- The uptime, the map cache step while it starts, or the error: shown while the server runs or failed (ShowFrame). -->
                        <TextBlock x:Name="StateDetail" Text="The server is stopped." Foreground="{DynamicResource Keep.TextDim}" FontSize="11" MaxWidth="260" TextWrapping="Wrap" Margin="2,4,0,0" Visibility="Collapsed"/>
                        <ProgressBar x:Name="StartTopProgress" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" Foreground="{DynamicResource Keep.GoldInk}" Background="{DynamicResource Keep.WarningSoft}" BorderThickness="0"/>
                    </StackPanel>
                    <ui:HeaderClock Grid.Column="3" Margin="16,0,0,0"/>
                </Grid>
            </Border>
            <!-- The notices: one at a time, the most urgent first (BannerStack.Priority), the rest behind "N more notices". -->
            <ui:BannerStack x:Name="Banners" DockPanel.Dock="Top" MaxShown="1">
                <!-- Coodsz's notice from compat-list/announcement.json (AnnouncementUi.cs in Shared/Frame): after the crash, report and reply bars, before the other notices, until Dismiss. -->
                <ui:Banner x:Name="AnnouncementBanner" Kind="Warn" CanDismiss="True" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="3"/>
                <Border x:Name="UpdateNoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Keep.PanelGradient}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="16,10" ui:BannerStack.Priority="4">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="InstallUpdateButton" ToolTip="Downloads and installs the new version of this tool, then opens it again." DockPanel.Dock="Right" Content="Install update" Click="InstallUpdate_Click" MinWidth="160" Margin="16,0,0,0" Style="{StaticResource UpdateInstall}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateNotice" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Amber}" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="UpdateProgress" Height="12" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" Foreground="{DynamicResource Keep.GoldInk}" Background="{DynamicResource Keep.WarningSoft}" BorderBrush="{DynamicResource Keep.GoldInk}" BorderThickness="1"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="ReplyBannerHost" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="2"/>
                <ContentControl x:Name="CrashBarHost" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="1"/>
            </ui:BannerStack>
            <Grid Margin="18">
                <!-- The tool's picture behind the page area (Keep.BackdropArt, set by Backdrop.Apply in App.xaml.cs) under the
                     Coop Server Tool's dark gradient (Keep.BackdropOverlayTop to Keep.BackdropOverlayBottom). -->
                <Rectangle x:Name="PageBackdrop" Margin="-18" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{DynamicResource Keep.BackdropArt}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="PageBackdropShade" Margin="-18" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource Keep.BackdropOverlayTop}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Keep.BackdropOverlayBottom}" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- The Dashboard: the server state with the one big button, the addresses, the newest server lines, game speed
                     and the players on the left; the mods, what the tool is made for and the Realm card on the right. -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- The side column goes under the main one when the page is too narrow for both (FitDashboard). -->
                    <Grid x:Name="DashGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="DashSideColumn" Width="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="DashMain" Margin="0,0,12,0">
                            <!-- First run (no save or no server folder yet): numbered steps with a button each (ShowFirstRunSteps). -->
                            <Border x:Name="FirstRunCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Get your server ready" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,0,0,10"/>
                                    <ui:StepsStrip x:Name="FirstRunSteps"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Chip x:Name="PasswordChip" Kind="Mute" Text="Password Open" Margin="0,0,6,0" ToolTip="Open: anyone with the address can join. Set: friends type the password. Change it on Settings, under Join."/>
                                            <ui:Chip x:Name="SteamChip" Kind="Mute" Text="Steam lobby Off" ToolTip="Whether the server shows a Steam lobby under your Steam name. Change it on Settings, under Join."/>
                                        </StackPanel>
                                        <TextBlock Text="Server status" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CURRENT SAVE" Foreground="{DynamicResource Keep.TextDim}" FontSize="11"/><TextBlock x:Name="DashSave" Text="-" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Tag="coodsz:no-translate"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="MOD SETUP" Foreground="{DynamicResource Keep.TextDim}" FontSize="11"/><TextBlock x:Name="DashSetup" Text="-" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Tag="coodsz:no-translate"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="PLAYERS" Foreground="{DynamicResource Keep.TextDim}" FontSize="11"/><TextBlock x:Name="DashPlayers" Text="0" FontSize="16" Margin="0,6,0,0" Tag="coodsz:no-translate"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PORTS" Foreground="{DynamicResource Keep.TextDim}" FontSize="11"/><TextBlock x:Name="DashPort" Text="UDP 4200" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Tag="coodsz:no-translate"/></StackPanel></Border>
                                    </UniformGrid>
                                    <TextBlock x:Name="ServerLoadText" ToolTipService.Placement="Top" FontSize="13" Foreground="{DynamicResource Keep.TextDim}" Margin="0,2,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="ServerLoad" ToolTip="CPU and memory of the server engine, every few seconds."/>
                                    <!-- The one big button: Start server and Stop server share the spot, ShowServerActions shows one. -->
                                    <WrapPanel Margin="0,4,0,8">
                                        <Grid Margin="0,0,12,4" VerticalAlignment="Center">
                                            <Button x:Name="StartButton" Style="{StaticResource Keep.BtnState}" Content="Start server" Click="StartButton_Click" AutomationProperties.AutomationId="StartServer" ToolTip="Starts the server with the save you picked, or makes the new campaign you named in step 1."/>
                                            <Button x:Name="StopButton" Style="{StaticResource Keep.BtnStateStop}" Content="Stop server" Click="Stop_Click" Visibility="Collapsed" AutomationProperties.AutomationId="StopServer" ToolTip="Saves the campaign, then stops the server. Asks you first. Players are disconnected."/>
                                        </Grid>
                                        <!-- Only while the server runs (ShowServerActions); Last good save also puts back a save while it is stopped. -->
                                        <WrapPanel x:Name="RunningActions" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button Style="{StaticResource Ghost}" Content="Save game" Click="Save_Click" AutomationProperties.AutomationId="SaveWorld" ToolTip="Saves the campaign. The server stays running and players stay connected."/>
                                            <Button x:Name="PauseServerButton" Style="{StaticResource Ghost}" Content="Pause" Click="PauseServer_Click" IsEnabled="False" AutomationProperties.AutomationId="PauseServer" ToolTip="Pauses campaign time on the running server. Players stay connected."/>
                                            <Button x:Name="PlayServerButton" Style="{StaticResource Ghost}" Content="Play" Click="PlayServer_Click" IsEnabled="False" AutomationProperties.AutomationId="PlayServer" ToolTip="Lets campaign time run at normal speed on the running server until you press Pause, also when every player is in a settlement or a battle. Right click for 2x speed.">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Play at 2x speed" Click="PlayServerFast_Click" ToolTip="Lets campaign time run at 2x speed on the running server."/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Style="{StaticResource Ghost}" Content="Restart" Click="Restart_Click" ToolTip="Saves the campaign, then restarts the server on the same save. Asks you first. Players are disconnected."/>
                                        </WrapPanel>
                                        <Button Style="{StaticResource Ghost}" Content="Last good save" Click="RestartLastGood_Click" AutomationProperties.AutomationId="RestartLastGood" ToolTip="Stops the server without saving. Puts back the newest save from before the hero lost their party, then starts the server."/>
                                    </WrapPanel>
                                    <!-- This PC's Bannerlord is newer than 1.4.8 (NewerGame): the same line as the Made for card, next to Start server. -->
                                    <TextBlock x:Name="NewerGameText" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Keep.WarningInk}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <!-- Something went wrong? Send your logs (CrashReportUi), next to Start server. -->
                                    <ContentControl x:Name="SendLogsLinkSlot" HorizontalAlignment="Left"/>
                                    <!-- RotServerNotes.FirewallHint: shown until this server folder's server once reached SERVING. -->
                                    <TextBlock x:Name="FirewallHintText" Margin="0,4,0,0" Foreground="{DynamicResource Keep.Warning}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="FirewallHint" Text="Windows may ask to allow .NET Host. Click Allow so players can join."/>
                                    <TextBlock x:Name="UptimeText" Text="Stopped." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <DockPanel x:Name="StartProgressRow" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="StartProgress">
                                        <TextBlock x:Name="StartProgressText" DockPanel.Dock="Right" MinWidth="44" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Keep.GoldInk}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <ProgressBar x:Name="StartProgress" Height="12" Minimum="0" Maximum="1" Foreground="{DynamicResource Keep.GoldInk}" Background="{DynamicResource Keep.WarningSoft}" BorderBrush="{DynamicResource Keep.GoldInk}" BorderThickness="1" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource Keep.PanelGradient}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1">
                                        <TextBlock x:Name="ControlStatus" FontWeight="SemiBold" TextWrapping="Wrap" Text="Ready." Foreground="{DynamicResource Keep.Teal}" AutomationProperties.AutomationId="ControlStatus"/>
                                    </Border>
                                    <TextBlock x:Name="PathText" Margin="0,4,0,0" Foreground="{DynamicResource Keep.TextDim}" FontSize="13" TextWrapping="Wrap"/>
                                    <Button x:Name="FindBannerlordButton" Content="Find Bannerlord" ToolTip="Pick the Mount &amp; Blade II Bannerlord folder. The tool remembers it." Click="FindBannerlord_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource Ghost}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Addresses your friends can use" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Primary}" Content="Copy invite" Click="CopyInvite_Click" ToolTip="Copies a short message for Discord with the best addresses and the port. The password is never in it."/>
                                            <Button Style="{StaticResource Ghost}" Content="How will friends join?" ToolTip="Checks your network and shows how friends can reach this server." Click="HowJoin_Click"/>
                                            <Button Style="{StaticResource Ghost}" Content="?" Click="HowJoin_Click" ToolTip="How to join" MinWidth="36"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="JoinBestText" Margin="0,6,0,8" Foreground="{DynamicResource Keep.Success}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="JoinAddressList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" ToolTip="An address friends can type to join." IsReadOnly="True" Height="30" Padding="6,0" VerticalContentAlignment="Center" FontFamily="Consolas"/>
                                                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Copy" Click="CopyAddress_Click" ToolTip="Copies this address so you can paste it to friends." Margin="6,0,0,0" Padding="10,4"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="{DynamicResource Keep.Teal}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox x:Name="RouterPortBox" Content="Open the port on my router automatically" Foreground="{DynamicResource Keep.TextMain}" Margin="0,8,0,0" Checked="RouterPort_Changed" Unchecked="RouterPort_Changed" ToolTip="Uses UPnP on your router while the server runs, like Porthole. The port is closed again when the server stops or this tool closes."/>
                                    <TextBlock x:Name="RouterPortStatus" Margin="24,4,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="12" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="FirewallButton" Style="{StaticResource Ghost}" Content="Allow through firewall" Click="Firewall_Click" Margin="0" ToolTip="Adds an inbound Windows Firewall rule for the server's UDP port and program. Windows asks for permission first."/>
                                        <Button Style="{StaticResource Ghost}" Content="Check again" Click="CheckJoining_Click" ToolTip="Checks the addresses, firewall and router port again."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FirewallStatus" Margin="0,4,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ui:LogCard x:Name="DashLog" Margin="0,12,0,0" MaxLines="8"/>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" AutomationProperties.AutomationId="GameSpeedArea">
                                <StackPanel>
                                    <TextBlock Text="Game speed" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GameSpeedLine" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GameSpeedBattleLine" FontSize="14" Foreground="{DynamicResource Keep.TextMain}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="GameSpeedButton" ToolTip="Turns 2x speed on the campaign map on or off and saves it. Restart the server to use it." Style="{StaticResource Primary}" Content="Turn on 2x speed" Margin="0,0,8,4" Click="GameSpeed_Click" AutomationProperties.AutomationId="GameSpeedButton"/>
                                        <Button x:Name="GameSpeedBattleButton" ToolTip="Turns the normal speed rule during player battles on or off and saves it. Restart the server to use it." Style="{StaticResource Ghost}" Content="Turn off battle speed limit" Margin="0,0,8,4" Click="GameSpeedBattle_Click" AutomationProperties.AutomationId="GameSpeedBattleButton"/>
                                        <Button x:Name="GameSpeedRestartButton" ToolTip="Saves the campaign, then restarts the server so the new speed applies. Asks you first." Style="{StaticResource Ghost}" Content="Restart server" Margin="0,0,8,4" Click="Restart_Click" Visibility="Collapsed" AutomationProperties.AutomationId="GameSpeedRestart"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="GameSpeedRestartLine" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Warning}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Players change the speed on the campaign map with the time buttons at the bottom of the screen, or with the keys 1, 2 and 3." FontSize="13" Foreground="{DynamicResource Keep.Teal}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="OnlinePlayersButton" Text="Online players: 0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.GoldInk}"/>
                                    <ListBox x:Name="PlayerBox" Height="120" Margin="0,8,0,8" Background="{DynamicResource Keep.BgInput}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" ItemContainerStyle="{StaticResource DarkListItem}" AutomationProperties.AutomationId="PlayerBox"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Ghost}" Content="Refresh" Margin="0" Click="RefreshPlayers_Click" ToolTip="Updates the list of online players." AutomationProperties.AutomationId="RefreshPlayers"/>
                                        <Button Style="{StaticResource Ghost}" Content="Kick player" Click="KickPlayer_Click" ToolTip="Disconnects the selected player. They can join again." AutomationProperties.AutomationId="KickPlayer"/>
                                        <Button Style="{StaticResource Danger}" Content="Ban player" Click="BanPlayer_Click" ToolTip="Adds the selected player to the ban list and kicks them." AutomationProperties.AutomationId="BanPlayer"/>
                                    </StackPanel>
                                    <TextBlock Text="Banned players" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Keep.GoldInk}" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="BanStatus" Text="No banned players." FontSize="15" Foreground="{DynamicResource Keep.Teal}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <ListBox x:Name="BanBox" Height="100" Margin="0,8,0,8" Background="{DynamicResource Keep.BgInput}" Foreground="{DynamicResource Keep.TextMain}" BorderBrush="{DynamicResource Keep.BorderDim}" ItemContainerStyle="{StaticResource DarkListItem}" AutomationProperties.AutomationId="BanBox"/>
                                    <Button Style="{StaticResource Ghost}" Content="Unban player" ToolTip="Removes the selected name from the ban list so they can join again." Margin="0" HorizontalAlignment="Left" Click="UnbanPlayer_Click" AutomationProperties.AutomationId="UnbanPlayer"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="DashSide" Grid.Column="1">
                            <!-- The mods the server loads in groups (ModsSummaryCard.Show in ShowModSetups, ModTally) and the setup Start server uses. -->
                            <ui:SideModsCard x:Name="ModsSummaryCard">
                                <ui:SideModsCard.Link>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Keep.BtnLink}" Content="Open Mods" Tag="Modules" Click="Nav_Click" ToolTip="Opens the Mods page, where you turn mods on and off and set their load order."/>
                                </ui:SideModsCard.Link>
                                <TextBlock x:Name="DashSetupLine" Foreground="{DynamicResource Keep.TextDim}" FontSize="12" TextWrapping="Wrap" Tag="coodsz:no-translate"/>
                            </ui:SideModsCard>
                            <!-- The game and mod versions this tool is made for, ticked against the server folder (ShowMadeFor). -->
                            <ui:MadeForCard x:Name="MadeForCard"/>
                            <!-- The Realm promo as a card plus the Join my server link in the sidebar footer (build-plan.md 7). -->
                            <ui:RealmCard x:Name="RealmCard">
                                <ui:RealmCard.Actions>
                                    <WrapPanel>
                                        <Button Style="{StaticResource Keep.BtnSolidGold}" Content="Join on Discord" Click="RealmJoin_Click" Margin="0,0,12,0" ToolTip="Opens the invite to The Realm Discord in your browser."/>
                                        <Button Style="{StaticResource Keep.BtnLink}" Content="Learn more" Tag="Realm" Click="Nav_Click" VerticalAlignment="Center" ToolTip="Opens the Join my server page about The Realm."/>
                                    </WrapPanel>
                                </ui:RealmCard.Actions>
                                <TextBlock Text="The Realm Bannerlord, my custom modded server" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap"/>
                            </ui:RealmCard>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <!-- Saves (Pages key "Server", so ShowPage("Server") still lands here): the campaign save, Prepare server and the backups. -->
                <ScrollViewer x:Name="ServerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <TextBlock Foreground="{DynamicResource Keep.TextDim}" FontSize="15" TextWrapping="Wrap">
                                <Run x:Name="SavesStepsIntro" Text="The steps are the same as on the Dashboard. Do 1 to 3 here, then click Start server on the Dashboard. "/>
                                <Run Text="Run Prepare server again after a Coop or mod update. It never deletes your campaigns." Foreground="{DynamicResource Keep.Warning}" FontWeight="SemiBold"/>
