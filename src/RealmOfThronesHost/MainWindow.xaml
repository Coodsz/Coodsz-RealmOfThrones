                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Prepare server" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Keep.Amber}"/>
                                    <TextBlock x:Name="PrepareStepText" Margin="0,4,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="14" TextWrapping="Wrap" Text="Copies Realm of Thrones and the mods into the Coop server and makes the server map. If it says something is missing, follow that line."/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Ghost}" Content="Prepare server" Margin="0,0,8,0" Click="Prepare_Click" AutomationProperties.AutomationId="PrepareServer" ToolTip="Checks the mods, copies Realm of Thrones and the setup's mods into the Coop server and makes the server map. It does not start the server. The first time takes a few minutes."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Keep.SuccessSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock x:Name="CampaignStepNumber" Text="3" Foreground="{DynamicResource Keep.Success}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Start a new campaign, or use one you have" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="14" TextWrapping="Wrap" Text="Type a name, then click New campaign or Start server. Start server makes a fresh Realm of Thrones world, no save needed. To host a campaign you already have, leave this empty and pick it below."/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <TextBox x:Name="NewCampaignBox" Width="220" Height="34" VerticalAlignment="Center" AutomationProperties.AutomationId="NewCampaignBox" ToolTip="The name of the new campaign. Use letters, numbers, spaces, hyphens or underscores."/>
                                        <Button Style="{StaticResource Primary}" Content="New campaign" Click="NewCampaign_Click" AutomationProperties.AutomationId="NewCampaign" ToolTip="Start server makes a fresh Realm of Thrones campaign under this name."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="NewCampaignNote" Margin="0,8,0,0" Foreground="{DynamicResource Keep.Success}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="NewCampaignNote"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Still step 3: the campaign you already have. -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Or pick a campaign you have" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="14" TextWrapping="Wrap" Text="If it says Single player copy, click Name server copy. Your Documents save stays as it is."/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <ComboBox x:Name="SaveBox" ToolTip="Pick the campaign save the server hosts. Hover a save to see where the file is." Style="{StaticResource SaveBoxStyle}" Width="280" Height="34" VerticalAlignment="Center" SelectionChanged="SaveBox_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel LastChildFill="False" ToolTip="{Binding FullPath}">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlaceText}" FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Keep.Teal}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Keep.TextMain}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DayText}" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Keep.Teal}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox x:Name="SaveNameBox" Width="160" Height="34" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="SaveNameBox" ToolTip="The name of the copy on the host. Leave this blank to use the campaign name. This does not rename the single player save."/>
                                        <Button Style="{StaticResource Primary}" Content="Name server copy" Click="NameSave_Click" AutomationProperties.AutomationId="NameSave" ToolTip="Copies or renames the host file. A single player campaign is copied and left unchanged."/>
                                        <Button Style="{StaticResource Danger}" Content="Delete server copy" Click="DeleteSave_Click" AutomationProperties.AutomationId="DeleteSave" ToolTip="Deletes a server copy only. Single player saves cannot be deleted."/>
                                        <Button Style="{StaticResource Ghost}" Content="Browse save" ToolTip="Pick a Realm of Thrones campaign save file from anywhere on this PC." Margin="8,0,0,0" Click="BrowseSave_Click" AutomationProperties.AutomationId="BrowseSave"/>
                                    </WrapPanel>
                                    <!-- Shown while the save box is empty (FillSaves), so a first host is not sent off to make a single player save. -->
                                    <TextBlock x:Name="SaveEmpty" Margin="0,8,0,0" Foreground="{DynamicResource Keep.Warning}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="SaveEmpty" Text="No campaign yet. Type a name above and click New campaign. You don't need a single player save."/>
                                    <TextBlock x:Name="SaveMissing" Margin="0,8,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SaveVersionWarning" Margin="0,8,0,0" Foreground="{DynamicResource Keep.Red}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="SaveVersionWarning"/>
                                    <StackPanel x:Name="SaveFacts" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0" MinWidth="120">
                                                <StackPanel>
                                                    <TextBlock Text="CHARACTER" Foreground="{DynamicResource Keep.Teal}" FontSize="11"/>
                                                    <TextBlock x:Name="SaveCharacter" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0" MinWidth="72">
                                                <StackPanel>
                                                    <TextBlock Text="LEVEL" Foreground="{DynamicResource Keep.Teal}" FontSize="11"/>
                                                    <TextBlock x:Name="SaveLevel" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Keep.BgInput}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" CornerRadius="6" Padding="12,8" MinWidth="110">
                                                <StackPanel>
                                                    <TextBlock Text="CAMPAIGN DAY" Foreground="{DynamicResource Keep.Teal}" FontSize="11"/>
                                                    <TextBlock x:Name="SaveDay" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="SaveModsHeading" Margin="0,10,0,0" Foreground="{DynamicResource Keep.Teal}" FontSize="12" Text="Mods written in this save"/>
                                        <ItemsControl x:Name="SaveMods" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Keep.BgRaised}" BorderBrush="{DynamicResource Keep.BorderDim}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Keep.TextMain}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Save backups: the copies after each save, and the one kept before a save ran with other mods. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Save backups" FontSize="17" FontWeight="SemiBold"/>
                                <Button Content="Restore save backup" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RestoreSaveBackup_Click" ToolTip="Puts back a save backup, either an automatic one made after each save or the copy kept before a save ran with other mods. The save as it is now is kept too."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
