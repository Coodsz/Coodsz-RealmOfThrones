                                        <Button Style="{StaticResource Ghost}" Content="Choose Coop server" Margin="0,0,8,0" Click="PickCoopServer_Click" AutomationProperties.AutomationId="ChooseCoopServerSaves" ToolTip="Pick the folder of the unpacked Coop server. The server runs from that folder."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
